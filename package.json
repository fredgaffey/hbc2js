{
  "name": "hbc2js",
  "version": "0.1.0",
  "private": true,
  "description": "Hermes bytecode (HBC) -> runnable JavaScript decompiler",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "hbc2js": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "tools/pkgsig/db"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\" && node tools/copy-build-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node tools/run-tests.mjs",
    "test:gate": "HBC2JS_E2E_DEFER=1 node --test \"tests/gate/**/*.test.ts\" \"tests/artifact/**/*.test.ts\" \"tests/project/**/*.test.ts\" \"tests/projdb/**/*.test.ts\" \"tests/secrets/**/*.test.ts\" \"tests/security/**/*.test.ts\" \"tests/appgen/**/*.test.ts\" \"tests/mcp/**/*.test.ts\" \"tests/readability/**/*.test.ts\" \"tests/workers/**/*.test.ts\" \"tests/ui-core/**/*.test.ts\" \"tests/ui-server/**/*.test.ts\" tests/fuzz/spec-consistency.test.ts && node --test tests/gate/ui/e2e-smoke.test.ts",
    "test:sweep": "HBC2JS_TIER=sweep node --test \"tests/sweep/**/*.test.ts\"",
    "test:all": "HBC2JS_TIER=all node --test \"tests/gate/**/*.test.ts\" \"tests/artifact/**/*.test.ts\" \"tests/project/**/*.test.ts\" \"tests/projdb/**/*.test.ts\" \"tests/secrets/**/*.test.ts\" \"tests/security/**/*.test.ts\" \"tests/appgen/**/*.test.ts\" \"tests/mcp/**/*.test.ts\" \"tests/readability/**/*.test.ts\" \"tests/workers/**/*.test.ts\" \"tests/ui-core/**/*.test.ts\" \"tests/ui-server/**/*.test.ts\" tests/fuzz/spec-consistency.test.ts && HBC2JS_TIER=all node --test \"tests/sweep/**/*.test.ts\"",
    "test:fuzz": "node --test \"tests/fuzz/**/*.test.ts\"",
    "gen:tables": "node tools/gen-tables/gen.ts",
    "gen:tables:check": "node tools/gen-tables/gen.ts --check",
    "fixtures": "tests/fixtures/build.sh",
    "cli": "node src/cli.ts",
    "ui-server": "node src/cli.ts ui-server",
    "test:e2e": "cd ui && npm run e2e"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/parser": "7.29.9",
    "@react-native/babel-preset": "0.85.3",
    "@react-native/metro-babel-transformer": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@types/node": "^22.15.0",
    "metro": "0.84.6",
    "metro-minify-terser": "0.84.6",
    "metro-transform-worker": "0.84.6",
    "react-native": "0.85.3",
    "typescript": "^5.8.0"
  }
}
